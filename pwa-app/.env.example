# Copy this to .env (never commit .env) and set real values.
# This is the login prompted for when the app loads — separate from the
# per-device HA/Homey tokens entered inside the app itself.
BASIC_AUTH_USER=changeme
BASIC_AUTH_PASS=changeme

# Optional: enables the header-token listener on :8091 for automation
# clients (foyer-mcp-server). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# FOYER_AGENT_TOKEN=
